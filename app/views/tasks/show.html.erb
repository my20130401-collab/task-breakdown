<% content_for :title, "#{@task.title} | Tasklet" %>

<div class="flex min-h-screen flex-col" data-controller="completed-filter">
  <%# 共通ヘッダー（マイタスクへ戻る） %>
  <%= render "shared/content_header" do %>
    <%= link_to tasks_path, aria: { label: "マイタスクに戻る" },
                class: "flex items-center gap-1.5 text-[13px] font-semibold text-muted hover:text-ink" do %>
      <%= render "shared/icon", name: :chevron_left, class: "h-4 w-4" %>マイタスク
    <% end %>
  <% end %>

  <% decomposition_status = @task.decomposition_status %>
  <% is_failed = decomposition_status == :failed %>
  <% is_pending = decomposition_status == :decomposing %>

  <div class="mx-auto w-full max-w-[850px] px-4 pb-16 pt-[64px]">
    <%# 分解ステータスとメニュー %>
    <div class="flex items-center justify-between">
      <div id="<%= "decomposition_status_#{@task.id}" %>">
        <%= render "shared/decomposition_status", status: decomposition_status %>
      </div>
      <%= render "shared/menu", id: "task-menu", label: "「#{@task.title}」のメニュー",
                                items: [ { label: "編集", href: edit_task_path(@task) },
                                         { label: "削除", href: task_path(@task), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, danger: true } ] %>
    </div>

    <%# 親タスクタイトル %>
    <h1 class="mt-5 font-serif text-[40px] font-bold leading-[1.45] tracking-tight"><%= @task.title %></h1>

    <%# 期限と進捗 %>
    <div class="mt-6 flex items-center gap-8">
      <p class="flex items-center gap-1.5 text-2xs text-muted" data-parent-due>
        <%= render "shared/icon", name: :calendar, class: "h-3.5 w-3.5" %><%= due_time_tag(@task.due_at) %>
      </p>
      <%= render "tasks/progress", task: @task %>
    </div>

    <%# Turbo Stream 受信アンテナ（AI 分解ジョブの結果を受け取る） %>
    <%= turbo_stream_from @task %>

    <%# 分解状態に応じた切り替えエリア %>
    <div id="<%= "decomposition_content_#{@task.id}" %>">
      <% if is_failed %>
        <%= render "tasks/decomposition_failed", task: @task %>
      <% elsif is_pending %>
        <%= render "tasks/decomposition_pending", task: @task %>
      <% else %>
        <%= render "tasks/subtasks_content", task: @task %>
      <% end %>
    </div>
  </div>
</div>
