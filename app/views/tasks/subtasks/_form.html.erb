<li class="rounded-xl border border-brand bg-brand-50 p-4 shadow-sm">
  <%= form_with model: subtask, url: task_subtask_path(task, subtask), class: "space-y-3" do |f| %>
    <div>
      <%= f.text_field :title, class: "w-full rounded-md border-line px-3 py-2 text-sm focus:border-brand focus:ring-brand", placeholder: "サブタスク名", autofocus: true %>
    </div>
    <div>
      <%= f.text_area :description, rows: 2, class: "w-full rounded-md border-line px-3 py-2 text-xs focus:border-brand focus:ring-brand", placeholder: "補足説明（任意）" %>
    </div>
    <div class="flex justify-end gap-2">
      <!-- キャンセル時は show アクションにリクエストを送り、元の表示に戻す -->
      <%= link_to "キャンセル", task_subtask_path(task, subtask), class: "rounded-md px-3 py-1.5 text-xs font-semibold text-muted hover:bg-surface" %>
      <%= f.submit "保存", class: "rounded-md bg-brand px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-dark cursor-pointer" %>
    </div>
  <% end %>
</li>
