<%#
  S-4 のサブタスク一覧。locals:
    task:     親タスク
    subtasks: 表示するサブタスク（日付タブで絞り込み済み）
  0 件のときは理由ごとに空状態を出し分ける（data-subtasks-empty）:
    none:     サブタスクが 1 件も無い（分解に失敗した、すべて削除した等）
    filtered: サブタスクはあるが、選んだ日付タブに該当するものが無い
  「タスクを追加」で一覧に入力欄が入ったときは、application.css のルールで空状態を隠す
  （そのため一覧の中に空白の文字を出さず、項目が無いときは :empty になるようにする）
%>
<% reason = task.children.exists? ? "filtered" : "none" %>
<div id="subtasks_list" class="mt-4">
  <ol id="subtasks-list" class="space-y-2.5 empty:hidden"><% subtasks.each.with_index(1) do |subtask, index| %><%= render "tasks/subtasks/subtask", subtask: subtask, number: format("%02d", index) %><% end %></ol>

  <% if reason == "none" %>
    <%= render "shared/empty_state", icon: :plus, title: "サブタスクはまだありません",
               body: "「タスクを追加」から手順を追加できます。",
               data: { subtasks_empty: reason }, hidden: subtasks.any? %>
  <% else %>
    <%= render "shared/empty_state", icon: :calendar, title: "該当するサブタスクはありません",
               body: "ほかの日付か「すべて」のタブで確認できます。",
               data: { subtasks_empty: reason }, hidden: subtasks.any? %>
  <% end %>
</div>
