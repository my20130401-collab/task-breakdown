<%#
  S-4 の日付タブ。locals: task, subtasks（全サブタスク。日付の抽出に使う）, current_filter（all / today / tomorrow / YYYY-MM-DD）
  押すとサーバ側で絞り込んだ一覧を Turbo Stream で受け取るリンクの並びなので、タブ（role=tablist）ではなく
  ナビゲーションとして表し、選んでいるタブを aria-current で伝える
%>
<%
  today = Time.zone.today
  tomorrow = Time.zone.tomorrow
  # サブタスク群から日付を抽出し、今日・明日を除外して昇順ソート（M/Dタブの動的生成）
  other_dates = subtasks.filter_map { |st| st.due_at&.to_date }.uniq.reject { |d| d == today || d == tomorrow }.sort
  tabs = [ [ "すべて", "all" ], [ "今日", "today" ], [ "明日", "tomorrow" ] ] +
         other_dates.map { |date| [ date.strftime("%-m/%-d"), date.to_s ] }
%>
<nav id="subtask_tabs" aria-label="日付で絞り込む" class="mt-12 flex overflow-x-auto border-b border-line text-[11px] font-semibold no-scrollbar">
  <% tabs.each do |label, filter| %>
    <% current = current_filter == filter %>
    <%= link_to label, task_subtasks_path(task, filter: filter),
          class: class_names("-mb-px border-b-2 px-4 py-3", "border-brand text-brand": current, "border-transparent text-muted hover:text-ink": !current),
          aria: { current: current ? "true" : nil },
          data: { turbo_stream: true } %>
  <% end %>
</nav>
