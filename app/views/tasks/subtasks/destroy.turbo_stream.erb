<%= turbo_stream.replace "subtasks_area" do %>
  <%= render "tasks/subtasks/content", task: @task %>
<% end %>

<%= turbo_stream.replace "task_progress_#{@task.id}" do %>
  <div id="task_progress_<%= @task.id %>" class="w-40" data-subtasks-target="progress">
    <%= render "shared/task_progress", done: @task.children.count(&:done?), total: @task.children.size %>
  </div>
<% end %>
